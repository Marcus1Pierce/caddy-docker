# Custom Caddy image: official alpine base + plugins compiled with xcaddy.
# NOT generated by `make` (this dir isn't in stackbrew-config.yaml variants),
# so the plugin list below is the source of truth. Edit it here.
#
# CADDY_VERSION and DIST_COMMIT are injected by CI from stackbrew-config.yaml,
# so bumping `caddy_version` there updates this image automatically. The ARG
# defaults below only apply for a standalone `docker build`.

FROM --platform=$BUILDPLATFORM golang:1.27-alpine3.24 AS builder
ARG TARGETOS
ARG TARGETARCH
ARG CADDY_VERSION=v2.11.7

RUN apk add --no-cache ca-certificates git

# xcaddy is a build tool, not part of the runtime image; pinned because its
# checksum is version-specific (see stackbrew-config.yaml xcaddy_config).
ENV XCADDY_VERSION=v0.4.7

# xcaddy for the *build* platform (runs on the runner, not the target)
RUN set -eux; \
	apkArch="$(apk --print-arch)"; \
	case "$apkArch" in \
		x86_64)  binArch='amd64'; checksum='99fd895a7b7799b18c43ea0915777d8701aaab2a010035b23495c28b4ae429edccd70adb9a01106180f8d9333d9b5df41e74f9702ce0e1cffcf8840698a9ab93' ;; \
		aarch64) binArch='arm64'; checksum='b4d52ad6db4184fa5366ef225d24b8340a47fc1924d250b329d3b95f416a0b14e16d72cf71f04f57046e8a26bad2b697ac14c833fc5f5607b9e1c838b9898520' ;; \
		*) echo >&2 "error: unsupported build architecture ($apkArch)"; exit 1 ;;\
	esac; \
	wget -O /tmp/xcaddy.tar.gz "https://github.com/caddyserver/xcaddy/releases/download/v0.4.7/xcaddy_0.4.7_linux_${binArch}.tar.gz"; \
	echo "$checksum  /tmp/xcaddy.tar.gz" | sha512sum -c; \
	tar x -z -f /tmp/xcaddy.tar.gz -C /usr/bin xcaddy; \
	rm -f /tmp/xcaddy.tar.gz; \
	chmod +x /usr/bin/xcaddy

# Cross-compile for the target platform (Go cross-compiles; no QEMU for this step)
RUN set -eux; \
	CGO_ENABLED=0 GOOS="$TARGETOS" GOARCH="$TARGETARCH" \
	xcaddy build "${CADDY_VERSION}" \
		--output /usr/bin/caddy \
		--with github.com/caddyserver/nginx-adapter@v0.0.7 \
		--with github.com/caddy-dns/cloudflare@v0.2.4 \
		--with github.com/corazawaf/coraza-caddy/v2@v2.6.1 \
		--with github.com/mholt/caddy-l4@v0.1.2

FROM alpine:3.23
ARG CADDY_VERSION=v2.11.7
ARG DIST_COMMIT=33ae08ff08d168572df2956ed14fbc4949880d94

RUN apk add --no-cache \
	ca-certificates \
	curl \
	libcap \
	mailcap

RUN set -eux; \
	mkdir -p \
		/config/caddy \
		/data/caddy \
		/etc/caddy \
		/usr/share/caddy \
	; \
	chmod 1777 /config/caddy /data/caddy; \
	wget -O /etc/caddy/Caddyfile "https://github.com/caddyserver/dist/raw/${DIST_COMMIT}/config/Caddyfile"; \
	wget -O /usr/share/caddy/index.html "https://github.com/caddyserver/dist/raw/${DIST_COMMIT}/welcome/index.html"

COPY --from=builder /usr/bin/caddy /usr/bin/caddy
RUN setcap cap_net_bind_service=+ep /usr/bin/caddy

# See https://caddyserver.com/docs/conventions#file-locations for details
ENV XDG_CONFIG_HOME=/config
ENV XDG_DATA_HOME=/data

LABEL org.opencontainers.image.version="${CADDY_VERSION}"
LABEL org.opencontainers.image.title=Caddy
LABEL org.opencontainers.image.description="a powerful, enterprise-ready, open source web server with automatic HTTPS written in Go"
LABEL org.opencontainers.image.url=https://caddyserver.com
LABEL org.opencontainers.image.documentation=https://caddyserver.com/docs
LABEL org.opencontainers.image.vendor="Light Code Labs"
LABEL org.opencontainers.image.licenses=Apache-2.0
LABEL org.opencontainers.image.source="https://github.com/Marcus1Pierce/caddy-docker"

EXPOSE 80
EXPOSE 443
EXPOSE 443/udp
EXPOSE 2019

WORKDIR /srv

CMD ["caddy", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]
